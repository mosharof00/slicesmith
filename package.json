{
  "name": "slicesmith",
  "version": "0.1.0",
  "description": "Deterministic Multi-Agent Build Harness for Full-Stack & Mobile Projects",
  "type": "module",
  "bin": {
    "slicesmith": "./dist/bin/slicesmith.js"
  },
  "scripts": {
    "dev": "tsx src/bin/slicesmith.ts",
    "build": "tsup src/bin/slicesmith.ts --format esm --out-dir dist",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai-agents",
    "build-harness",
    "orchestration",
    "full-stack",
    "mobile"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^3.0.0",
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "dotenv": "^18.0.9",
    "glob": "^14.0.4",
    "ora": "^10.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
